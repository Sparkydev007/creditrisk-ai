# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/creditrisk
DATABASE_USERNAME=creditrisk
DATABASE_PASSWORD=creditrisk_secret

# JWT
JWT_SECRET=your-256-bit-secret-key-change-in-production
JWT_EXPIRATION_MS=86400000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_APPLICATION_EVENTS=application-events
KAFKA_TOPIC_RISK_EVENTS=risk-events
KAFKA_TOPIC_DECISION_EVENTS=decision-events
KAFKA_TOPIC_AUDIT_EVENTS=audit-events

# ML Service
ML_SERVICE_URL=http://ml-service:8001

# Application
SPRING_PROFILES_ACTIVE=local

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Frontend
REACT_APP_API_URL=http://localhost:8080

# AWS (for cloud deployment)
AWS_REGION=us-east-1
