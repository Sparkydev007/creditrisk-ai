{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://REPLACE-WITH-YOUR-API-HOST/api/$1" },
    { "source": "/actuator/(.*)", "destination": "https://REPLACE-WITH-YOUR-API-HOST/actuator/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
